# ==============================================================================
# Environment Configuration - UNRAM International Office (Static Export)
# ==============================================================================

# Public URL of the deployed website (used for canonical URLs and social previews)
NEXT_PUBLIC_SITE_URL=https://io.unram.ac.id

# Optional subfolder path if the site is hosted in a sub-directory (e.g. /international)
# Default is empty for root domain hosting.
NEXT_PUBLIC_BASE_PATH=

# SHA-256 hash of the admin dashboard passcode (in lowercase hex)
# Default below is the SHA-256 hash of "unram2026":
# 47d6a9d851060c7e5a5037a8dfad149fbe0698199058b22f140086eeced8193a
# To generate your own hash, run:
# powershell -Command "[BitConverter]::ToString([System.Security.Cryptography.SHA256]::Create().ComputeHash([System.Text.Encoding]::UTF8.GetBytes('your_passcode'))).Replace('-','').ToLower()"
NEXT_PUBLIC_ADMIN_PASSCODE_HASH=47d6a9d851060c7e5a5037a8dfad149fbe0698199058b22f140086eeced8193a

# Web3Forms API Key for static contact form submissions (https://web3forms.com)
# If omitted or unconfigured, contact submissions gracefully fallback to mailto:io@unram.ac.id
NEXT_PUBLIC_WEB3FORMS_KEY=
