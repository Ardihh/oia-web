# ==============================================================================
# Environment Configuration Template - UNRAM International Office (Static Export)
# ==============================================================================
#
# PENTING: Variabel berawalan NEXT_PUBLIC_* di-inline ke berkas JavaScript pada
# saat 'npm run build' dijalankan. Pastikan nilai ini sudah diatur pada mesin yang
# menjalankan proses build.
#
# Kunci publishable Supabase bersifat publik secara desain; seluruh proteksi
# keamanan berasal dari Row Level Security (RLS) di database.
# ==============================================================================

# Supabase Project Credentials (Dapatkan dari Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Public URL of the deployed website (used for canonical URLs and social previews)
NEXT_PUBLIC_SITE_URL=https://io.unram.ac.id

# Optional subfolder path if the site is hosted in a sub-directory (e.g. /international)
NEXT_PUBLIC_BASE_PATH=

# Web3Forms API Key for static contact form submissions (https://web3forms.com)
NEXT_PUBLIC_WEB3FORMS_KEY=
